:13},{"title":"الباب الثالث: حقوق الوالدين على الأولاد","url":"https://dorar.net/feqhia/5390","entries":11},{"title":"الباب الرابع: حقوق الرحم والقرابة","url":"https://dorar.net/feqhia/5416","entries":5},{"title":"الباب الخامس: حقوق الخدم [1358] أصبح الخدم في كثير من البيوت جزءا من الأسرة، وهم لهم وعليهم حقوق وردت في عدد من الأحاديث، إلا أن كثيرا منها ومن نصوص الفقهاء إنما تتحدث عن الخدم المملوكين، أو عن الأجراء، وهؤلاء يشتركون مع الخدم الذين يخدمون في البيوت في هذا العصر -سواء من الرجال أو النساء- في كثير من هذه الحقوق ولكن مما يؤسف له اليوم: ما نراه من سوء تعامل المخدومين مع خادميهم؛ من ضربهم، وشتمهم، وتحميلهم ما لا يطيقون من الأعمال، وأكل حقوقهم ظلما وعدوانا؛ فليتق الله هؤلاء، وليعلموا أن الله سائلهم عن هذه المعاملة السيئة!","url":"https://dorar.net/feqhia/5429","entries":5}]},{"no":23,"title":"كتاب الأيمان","url":"https://dorar.net/feqhia/5483","entries":117,"chapters":[{"title":"الباب الأول: تعريف اليمين، ومشروعيتها، والحكمة منها، وأركانها","url":"https://dorar.net/feqhia/5486","entries":48},{"title":"الباب الثاني: أنواع اليمين، والتورية فيه","url":"https://dorar.net/feqhia/5608","entries":11},{"title":"الباب الثالث: انحلال اليمين، والحنث فيه، وشروطه","url":"https://dorar.net/feqhia/5637","entries":22},{"title":"الباب الرابع: كفارة اليمين","url":"https://dorar.net/feqhia/5690","entries":36}]},{"no":24,"title":"كتاب النذور","url":"https://dorar.net/feqhia/5778","entries":53,"chapters":[{"title":"الباب الأول: تعريف النذر وحكمه وأنواعه","url":"https://dorar.net/feqhia/5781","entries":12},{"title":"الباب الثاني: شروط الناذر والمنذور","url":"https://dorar.net/feqhia/5810","entries":11},{"title":"الباب الثالث: صيغ النذر، ووقت وجوب الوفاء به، واعتبار نية الناذر","url":"https://dorar.net/feqhia/5835","entries":10},{"title":"الباب الرابع: العجز عن النذر، وتحديد أماكنه، والشك فيه","url":"https://dorar.net/feqhia/5865","entries":7},{"title":"الباب الخامس: أحكام كفارة النذر، وقضائه","url":"https://dorar.net/feqhia/5883","entries":7},{"title":"الباب السادس: مسائل متفرقة","u
# Replace placeholders locally. Never commit a populated .env file.
POSTGRES_DB=daleel
POSTGRES_USER=daleel
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql+psycopg://daleel:CHANGE_ME_LOCAL_ONLY@localhost:5432/daleel
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_ENV=development
STT_PROVIDER=mock
TTS_PROVIDER_AR=mock
TTS_PROVIDER_EN=mock
EMBEDDING_PROVIDER=e5
RERANKER_PROVIDER=qwen
GENERATION_PROVIDER=openai
OPENAI_API_KEY=

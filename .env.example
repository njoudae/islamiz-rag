# Replace placeholders locally. Never commit a populated .env file.
POSTGRES_DB=daleel
POSTGRES_USER=daleel
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql+psycopg://daleel:CHANGE_ME_LOCAL_ONLY@localhost:5432/daleel
APP_ENV=development
STT_PROVIDER=mock
TTS_PROVIDER_AR=mock
TTS_PROVIDER_EN=mock
EMBEDDING_PROVIDER=e5
RERANKER_PROVIDER=qwen
GENERATION_PROVIDER=openai
OPENAI_API_KEY=
E5_MODEL=intfloat/multilingual-e5-small
QWEN_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
OPENAI_GENERATION_MODEL=gpt-6.1-sol
CRAWL_DELAY_SECONDS=2.5
CRAWL_USER_AGENT=DaleelResearchBot/0.1 (+your-contact)

# --- Website backend (Laravel, apps/site) ---
# Shared secret the website backend sends to the AI service. Any long random string.
AI_SERVICE_TOKEN=CHANGE_ME_LOCAL_ONLY
# Dummy administrator for the admin area at http://localhost:8080/login
ADMIN_EMAIL=admin@daleel.sa
ADMIN_PASSWORD=daleel-admin-2026
# Shows those credentials on the login page. Set to false for a real deployment.
ADMIN_SHOW_CREDENTIALS=true
# Fill the dashboards with clearly labelled synthetic history on first start.
SEED_DEMO_DATA=false
# Address shown on the contact page. Set it to the mailbox the team reads.
CONTACT_EMAIL=contact@daleel.sa
# Optional. Generated and kept on a Docker volume when left empty.
APP_KEY=

# --- Host ports (change only if one is already in use) ---
SITE_PORT=8080
AI_PORT=8000
POSTGRES_PORT=5432

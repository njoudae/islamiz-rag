# Applies to builds that use the repository root as context (AI service, single-container demo).
# apps/site also has its own build context and its own .dockerignore.
.git
**/.env
**/.env.*
!**/.env.example

**/node_modules
**/.next
**/__pycache__
**/.pytest_cache
**/*.py[cod]
**/.venv
**/.venv-real

# The website's source is needed by deploy/render/Dockerfile; its local state is not.
apps/site/vendor
apps/site/public/build
apps/site/public/hot
apps/site/public/storage
apps/site/storage/app/private/*
apps/site/storage/framework/cache/data/*
apps/site/storage/framework/sessions/*
apps/site/storage/framework/views/*
apps/site/storage/logs/*
apps/site/bootstrap/cache/*.php
apps/site/database/*.sqlite
apps/site/tests

docs
assets
evaluation
scripts

# Only the production index is needed at run time; everything else is evidence output.
artifacts/*
!artifacts/benchmark
artifacts/benchmark/*
!artifacts/benchmark/final_30q_retrieval
artifacts/benchmark/final_30q_retrieval/*
!artifacts/benchmark/final_30q_retrieval/production_index
